---
import { wavePoints } from '../lib/wave';
interface Props {
  lang: string;
  frequencyLabel: string;
  graphLabel: string;
  noScript: string;
}

const { lang, frequencyLabel, graphLabel, noScript } = Astro.props;
const initialFrequency = new Intl.NumberFormat(lang, {
  minimumFractionDigits: 1, maximumFractionDigits: 1,
}).format(1);
---

<sine-wave lang={lang} data-graph-label={graphLabel}>
  <label>
    <span>{frequencyLabel} <output>{initialFrequency} Hz</output></span>
    <input type="range" min="0.5" max="3" step="0.1" value="1" />
  </label>
  <svg viewBox="0 0 600 200" role="img" aria-label={graphLabel.replace('{frequency}', initialFrequency)}>
    <path d="M36 30 V190 M36 110 H564" class="axis" />
    <polyline points={wavePoints(1)} fill="none" stroke="currentColor" stroke-width="2.5" />
  </svg>
  <div class="axis-labels" aria-hidden="true"><span>0 s</span><span>1 s</span><span>2 s</span></div>
  <noscript>{noScript}</noscript>
</sine-wave>

<script>
  import { wavePoints } from '../lib/wave';

  class SineWave extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input')!;
      const output = this.querySelector('output')!;
      const curve = this.querySelector('polyline')!;
      const graph = this.querySelector('svg')!;
      const numberFormat = new Intl.NumberFormat(this.lang, {
        minimumFractionDigits: 1, maximumFractionDigits: 1,
      });

      const update = () => {
        const frequency = Number(input.value);
        const formatted = numberFormat.format(frequency);
        output.value = `${formatted} Hz`;
        curve.setAttribute('points', wavePoints(frequency));
        graph.setAttribute('aria-label', this.dataset.graphLabel!.replace('{frequency}', formatted));
      };

      input.addEventListener('input', update);
      update();
    }
  }

  customElements.define('sine-wave', SineWave);
</script>

<style>
  sine-wave { display: block; margin: 2rem 0; padding: 1.25rem; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; color: var(--accent); }
  label { display: block; font: 0.85rem var(--font-mono); color: var(--text); }
  label span { display: flex; justify-content: space-between; gap: 1rem; }
  output { font-variant-numeric: tabular-nums; }
  input { display: block; width: 100%; margin: 1rem 0; accent-color: var(--accent); }
  svg { display: block; width: 100%; }
  .axis { fill: none; stroke: var(--border); stroke-width: 1; }
  .axis-labels { display: flex; justify-content: space-between; padding: 0 6%; color: var(--muted); font: 0.8rem var(--font-mono); }
</style>
