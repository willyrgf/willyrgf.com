---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localizePost, type PostPageProps } from '../lib/posts';
import { getMessages, languageTags, localizedPath, type Locale } from '../i18n';

type Props = PostPageProps;

const { post, locale } = Astro.props;
const { entry, contentLocale } = localizePost(post, locale);
const { Content } = await render(entry);
const ui = getMessages(locale);
const availableLocales: Locale[] = post.portuguese ? ['en', 'pt-br'] : ['en'];
const date = new Intl.DateTimeFormat(languageTags[locale], {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(post.english.data.date);
---

<Base title={entry.data.title} description={entry.data.description} locale={locale}
  canonicalPath={localizedPath(contentLocale, `posts/${post.slug}`)} availableLocales={availableLocales}>
  <article lang={languageTags[contentLocale]}>
    {locale !== contentLocale && <p class="translation-notice" lang={languageTags[locale]}>{ui.englishFallback}</p>}
    <header class="post-header">
      <time datetime={post.english.data.date.toISOString()} lang={languageTags[locale]}>{date}</time>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
  <p class="back-link"><a href={localizedPath(locale)}>{ui.allPosts}</a></p>
</Base>
