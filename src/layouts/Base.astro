---
import '../styles/global.css';
import hackFont from '../assets/fonts/hack-nerd-regular.woff2?url';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = siteConfig.description,
} = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const aboutUrl = `${import.meta.env.BASE_URL}about/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={hackFont} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href={import.meta.env.BASE_URL}>{siteConfig.title}</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href={aboutUrl} aria-current={Astro.url.pathname === aboutUrl ? 'page' : undefined}>About</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
